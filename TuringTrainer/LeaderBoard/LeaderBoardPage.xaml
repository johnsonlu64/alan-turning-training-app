<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuringTrainer.LeaderBoardPage"
            Background="#0A0A0A">

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="LEADERBOARD👑"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#FFD600"
                HorizontalOptions="Center"
                Margin="1,0,0,0"/>

            <Border
                Stroke="#FFD600"
                StrokeThickness="2"
                Padding="10">

                <VerticalStackLayout
                    Spacing="10">

                    <Grid
                        ColumnDefinitions="50,*,Auto"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="Rank"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#FFFFFB02"/>

                        <Label
                            Grid.Column="1"
                            Text="Athelete Name"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#FFFFFB02"
                            HorizontalOptions="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="Points"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#FFFFFB02"/>

                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD"/>

                    <Grid
                        ColumnDefinitions="50,*,Auto"
                        ColumnSpacing="12">

                        <Label Grid.Column="0"
                               Text="🥇1"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="1"
                               Text="Alex Morgan"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="2"
                               Text="1250"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD"/>

                    <Grid
                        ColumnDefinitions="50,*,Auto"
                        ColumnSpacing="12">

                        <Label Grid.Column="0"
                               Text="🥈2"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="1"
                               Text="Megan Rapinoe"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="2"
                               Text="1100"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD"/>

                    <Grid
                        ColumnDefinitions="50,*,Auto"
                        ColumnSpacing="12">

                        <Label Grid.Column="0"
                               Text="🥉3"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="1"
                               Text="Sam Kerr"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>

                        <Label Grid.Column="2"
                               Text="950"
                               TextColor="#FFFFFB02"
                               FontSize="18"/>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <VerticalStackLayout
                Spacing="10">

                <Label
                Text="Team Members"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#FFD600"
                HorizontalOptions="Center"/>
            </VerticalStackLayout>


            <VerticalStackLayout
                Spacing="10">
                <Label
                    Text="Student1"
                    FontSize="18"
                    TextColor="#FFFFFB02"/>

                <Label
                    Text="Student2"
                    FontSize="18"
                    TextColor="#FFFFFB02"/>

                <Label
                    Text="Student3"
                    FontSize="18"
                    TextColor="#FFFFFB02"/>

                <Label
                    Text="Student4"
                    FontSize="18"
                    TextColor="#FFFFFB02"/>

                <Label
                    Text="Student5"
                    FontSize="18"
                    TextColor="#FFFFFB02"/>
            </VerticalStackLayout>


        </VerticalStackLayout>

    
</ContentPage>