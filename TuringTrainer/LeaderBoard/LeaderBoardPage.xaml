<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuringTrainer.LeaderBoardPage"
             Background="#101010"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="20">

        <!-- Leaderboard title -->
        <Label Grid.Row="0"
               Text="LEADERBOARD👑"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#FFD600"
               HorizontalOptions="Center"
               Margin="1,0,0,0"/>

        <!-- Class selector -->
        <Picker Grid.Row="1"
                x:Name="ClassPicker"
                TextColor="White"
                FontSize="22"
                BackgroundColor="#1C1C1C"
                SelectedIndexChanged="OnClassChanged"/>

        <!-- Scrollable athlete list -->
        <CollectionView Grid.Row="2"
                        x:Name="Board"
                        VerticalOptions="Fill"
                        ItemsLayout="VerticalList">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#FFD600"
                            StrokeThickness="1"
                            Padding="15"
                            Margin="0,0,0,2"
                            BackgroundColor="#1C1C1C"
                            StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="12">

                            <Label Text="{Binding Name}"
                                   TextColor="White"
                                   FontSize="18"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Points}"
                                   TextColor="#FFD600"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>