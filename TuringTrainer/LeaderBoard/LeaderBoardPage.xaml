<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lb="clr-namespace:TuringTrainer.LeaderBoard"
             x:Class="TuringTrainer.LeaderBoardPage"
             Background="{DynamicResource PageBgBrush}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20,16,20,0"
          RowSpacing="15">

        <VerticalStackLayout Spacing="10">

            <Label Text="Leaderboard"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextAccent}"/>

            <Label Text="Ranked by PR ÷ body weight at the PR."
                   FontSize="13"
                   TextColor="{DynamicResource TextMuted}"/>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Class"
                           TextColor="{DynamicResource TextMuted}"/>

                    <Picker x:Name="ClassPicker"
                            Title="Select a class"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnClassChanged"
                            TextColor="{DynamicResource TextMain}"
                            TitleColor="{DynamicResource TextMuted}"
                            BackgroundColor="{DynamicResource InsetBg}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                        Spacing="4">
                    <Label Text="Group"
                           TextColor="{DynamicResource TextMuted}"/>

                    <Picker x:Name="GroupPicker"
                            Title="Select a group"
                            IsEnabled="False"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnGroupChanged"
                            TextColor="{DynamicResource TextMain}"
                            TitleColor="{DynamicResource TextMuted}"
                            BackgroundColor="{DynamicResource InsetBg}"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Exercise"
                       TextColor="{DynamicResource TextMuted}"/>

                <Picker x:Name="ExercisePicker"
                        Title="Select an exercise"
                        IsEnabled="False"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedIndexChanged="OnExerciseChanged"
                        TextColor="{DynamicResource TextMain}"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource InsetBg}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <Label x:Name="StatusLabel"
                       Text="Loading classes…"
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource TextMuted}"/>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Text="Refresh"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="{DynamicResource InsetBg}"
                        TextColor="{DynamicResource TextAccent}"/>
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               Color="{DynamicResource TextAccent}"/>
        </VerticalStackLayout>

        <!-- Ranked athletes -->
        <CollectionView x:Name="Board"
                        Grid.Row="1"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="lb:LeaderboardRow">

                    <Border Padding="14"
                            Margin="0,0,0,10"
                            Stroke="{DynamicResource CardBorderBrush}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="28,*,72"
                                  ColumnSpacing="6">

                                <Label Text="{Binding RankText}"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextAccent}"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMain}"/>

                                <Label Grid.Column="2"
                                       Text="{Binding RatioText}"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{DynamicResource TextAccent}"/>
                            </Grid>

                            <Label Text="{Binding PrText}"
                                   TextColor="{DynamicResource TextMain}"/>

                            <Label Text="{Binding PrBodyWeightText}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>

                            <Label Text="{Binding CurrentWeightText}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>

                            <Label Text="{Binding RecordedText}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button Text="Update weight"
                                        FontSize="12"
                                        Clicked="OnUpdateWeightClicked"
                                        BackgroundColor="{DynamicResource TextAccent}"
                                        TextColor="{DynamicResource NavBg}"/>

                                <Button Grid.Column="1"
                                        Text="PR options"
                                        FontSize="12"
                                        Clicked="OnPrOptionsClicked"
                                        BackgroundColor="{DynamicResource InsetBg}"
                                        TextColor="{DynamicResource TextAccent}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="BottomNavigation"
              Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              Padding="0,12,0,16"
              BackgroundColor="{DynamicResource NavBg}">

            <VerticalStackLayout Spacing="4">
                <Button Text="🏠"
                        FontSize="23"
                        TextColor="{DynamicResource TextDim}"
                        Clicked="OnHomeClicked"
                        HorizontalOptions="Center"/>

                <Label Text="Home"
                       FontSize="10"
                       TextColor="{DynamicResource TextDim}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4">
                <Button Text="👑"
                        FontSize="22"
                        TextColor="{DynamicResource TextAccent}"
                        HorizontalOptions="Center"/>

                <Label Text="Leaderboard"
                       FontSize="10"
                       TextColor="{DynamicResource TextAccent}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2"
                                 Spacing="4">
                <Button Text="📊"
                        FontSize="22"
                        TextColor="{DynamicResource TextDim}"
                        Clicked="OnMetricsClicked"
                        HorizontalOptions="Center"/>

                <Label Text="Metrics"
                       FontSize="10"
                       TextColor="{DynamicResource TextDim}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3"
                                 Spacing="4">
                <Button Text="⚙️"
                        FontSize="22"
                        TextColor="{DynamicResource TextDim}"
                        Clicked="OnSettingsClicked"
                        HorizontalOptions="Center"/>

                <Label Text="Settings"
                       FontSize="10"
                       TextColor="{DynamicResource TextDim}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>