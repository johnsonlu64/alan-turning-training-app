<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuringTrainer.WelcomePage"
             BackgroundColor="White">

    <Grid>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Welcome to"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

                <Label
                Text="Turing Trainer"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Image
                Source="barbell.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Barbell" />

            <Button
                x:Name="LoginButton"
                Text="Log in" 
                BackgroundColor="#FFDAC508"
                SemanticProperties.Hint="Log in to your account"
                Clicked="LoginButton_Clicked"
                HorizontalOptions="Fill"
                TextColor="White" />

            <Button
                x:Name="SignupButton"
                BackgroundColor="#FFDAC508"
                Text="Sign up" 
                SemanticProperties.Hint="Register a new account"
                Clicked="SignupButton_Clicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
