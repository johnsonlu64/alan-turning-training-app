<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="TuringTrainer.SignupPage"
	Title="Create Account"
	Background="{DynamicResource PageBgBrush}">

	<Grid>
		<VerticalStackLayout
			Padding="30"
			Spacing="18"
			VerticalOptions="Center">

			<Label
				Text="CREATE ACCOUNT"
				FontSize="28"
				FontAttributes="Bold"
				TextColor="{DynamicResource TextAccent}"
				HorizontalOptions="Center"
				Margin="0,0,0,12" />

			<Entry
				x:Name="UsernameEntry"
				Placeholder="Username"
				TextColor="{DynamicResource TextMain}"
				PlaceholderColor="{DynamicResource TextSub}"
				Background="{DynamicResource InsetBgBrush}" />

			<Entry
				x:Name="EmailEntry"
				Placeholder="Email"
				Keyboard="Email"
				TextColor="{DynamicResource TextMain}"
				PlaceholderColor="{DynamicResource TextSub}"
				Background="{DynamicResource InsetBgBrush}" />

			<Entry
				x:Name="PasswordEntry"
				Placeholder="Password"
				IsPassword="True"
				TextColor="{DynamicResource TextMain}"
				PlaceholderColor="{DynamicResource TextSub}"
				Background="{DynamicResource InsetBgBrush}" />

			<Button
				Text="SIGN UP"
				FontAttributes="Bold"
				Background="{DynamicResource TextAccentBrush}"
				TextColor="{DynamicResource PageBg}"
				HeightRequest="58"
				Margin="0,10,0,0" 
				Clicked="SignupButton_Clicked"/>
		</VerticalStackLayout>
	</Grid>
</ContentPage>
