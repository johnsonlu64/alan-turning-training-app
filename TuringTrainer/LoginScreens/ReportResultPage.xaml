<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TuringTrainer.Models"
    x:Class="TuringTrainer.ReportResultsPage"
    Title="Report"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="25,30" Spacing="18">

            <Label x:Name="TitleLabel"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextAccent}" />
            <Label x:Name="RangeLabel"
                   FontSize="13"
                   TextColor="{DynamicResource TextSub}"
                   Margin="0,-12,0,6" />

            <!-- Summary -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CompletionValue" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource TextAccent}" HorizontalOptions="Center" />
                        <Label Text="COMPLETION" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AthletesValue" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource TextMain}" HorizontalOptions="Center" />
                        <Label Text="ATHLETES" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AssignedValue" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource TextMain}" HorizontalOptions="Center" />
                        <Label Text="ASSIGNED" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CompletedValue" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}" HorizontalOptions="Center" />
                        <Label Text="COMPLETED" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="PartialValue" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A65F00, Dark=#FFA726}" HorizontalOptions="Center" />
                        <Label Text="PARTIAL" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="MissedValue" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#C62828, Dark=#EF5350}" HorizontalOptions="Center" />
                        <Label Text="MISSED" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource TextSub}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Athletes -->
            <Label Text="ATHLETES" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextMain}" Margin="0,8,0,0" />

            <Label x:Name="EmptyLabel"
                   Text="No athletes matched these filters. Check that students are enrolled in the class and workouts are scheduled in this date range."
                   FontSize="13"
                   TextColor="{DynamicResource TextSub}"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="AthleteLayout" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:AthleteReportRow">
                        <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardBorderBrush}" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextMain}" />
                                    <Label Grid.Column="1" Text="{Binding PercentText}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextAccent}" />
                                </Grid>
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource TextAccent}" BackgroundColor="{DynamicResource DividerLine}" />
                                <Label Text="{Binding Summary}" FontSize="12" TextColor="{DynamicResource TextSub}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Partial reasons -->
            <Label x:Name="PartialsHeader"
                   Text="PARTIAL WORKOUT REASONS"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextMain}"
                   Margin="0,8,0,0" />

            <VerticalStackLayout x:Name="PartialsLayout" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PartialReasonRow">
                        <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{AppThemeBinding Light=#A65F00, Dark=#FFA726}" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Heading}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A65F00, Dark=#FFA726}" />
                                <Label Text="{Binding ReasonText}" FontSize="14" TextColor="{DynamicResource TextMain}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Text="EXPORT CSV"
                FontAttributes="Bold"
                FontSize="16"
                BackgroundColor="{DynamicResource TextAccent}"
                TextColor="{DynamicResource PageBg}"
                CornerRadius="12"
                HeightRequest="58"
                Margin="0,10,0,10"
                Clicked="OnExportClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
