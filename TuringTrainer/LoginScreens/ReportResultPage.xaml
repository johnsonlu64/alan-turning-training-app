<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TuringTrainer.Models"
    x:Class="TuringTrainer.ReportResultsPage"
    Title="Report"
    BackgroundColor="#0A0A0A">

    <ScrollView>
        <VerticalStackLayout Padding="25,30" Spacing="18">

            <Label x:Name="TitleLabel"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#FFD600" />
            <Label x:Name="RangeLabel"
                   FontSize="13"
                   TextColor="#A0A0A0"
                   Margin="0,-12,0,6" />

            <!-- Summary -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CompletionValue" FontSize="22" FontAttributes="Bold" TextColor="#FFD600" HorizontalOptions="Center" />
                        <Label Text="COMPLETION" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AthletesValue" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="ATHLETES" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AssignedValue" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="ASSIGNED" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CompletedValue" FontSize="22" FontAttributes="Bold" TextColor="#66BB6A" HorizontalOptions="Center" />
                        <Label Text="COMPLETED" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="PartialValue" FontSize="22" FontAttributes="Bold" TextColor="#FFA726" HorizontalOptions="Center" />
                        <Label Text="PARTIAL" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="MissedValue" FontSize="22" FontAttributes="Bold" TextColor="#EF5350" HorizontalOptions="Center" />
                        <Label Text="MISSED" FontSize="10" CharacterSpacing="1" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Athletes -->
            <Label Text="ATHLETES" FontSize="14" FontAttributes="Bold" TextColor="White" Margin="0,8,0,0" />

            <Label x:Name="EmptyLabel"
                   Text="No athletes matched these filters. Check that students are enrolled in the class and workouts are scheduled in this date range."
                   FontSize="13"
                   TextColor="#A0A0A0"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="AthleteLayout" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:AthleteReportRow">
                        <Border BackgroundColor="#151515" Stroke="#333333" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                    <Label Grid.Column="1" Text="{Binding PercentText}" FontSize="16" FontAttributes="Bold" TextColor="#FFD600" />
                                </Grid>
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="#FFD600" BackgroundColor="#2A2A2A" />
                                <Label Text="{Binding Summary}" FontSize="12" TextColor="#A0A0A0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Partial reasons -->
            <Label x:Name="PartialsHeader"
                   Text="PARTIAL WORKOUT REASONS"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <VerticalStackLayout x:Name="PartialsLayout" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PartialReasonRow">
                        <Border BackgroundColor="#151515" Stroke="#FFA726" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Heading}" FontSize="12" FontAttributes="Bold" TextColor="#FFA726" />
                                <Label Text="{Binding ReasonText}" FontSize="14" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Text="EXPORT CSV"
                FontAttributes="Bold"
                FontSize="16"
                BackgroundColor="#FFD600"
                TextColor="#0A0A0A"
                CornerRadius="12"
                HeightRequest="58"
                Margin="0,10,0,10"
                Clicked="OnExportClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
