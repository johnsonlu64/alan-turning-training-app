<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:models="clr-namespace:TuringTrainer.Models"
       x:Class="TuringTrainer.Homepage"
       BackgroundColor="{DynamicResource PageBg}"
       Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*,Auto"
             Padding="20,12,20,0">

              <!-- Header -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Padding="0,12,0,24">

                     <VerticalStackLayout Spacing="4">
                            <Label Text="TURINGTRAINER"
                                   FontSize="12"
                                   CharacterSpacing="3"
                                   TextColor="{DynamicResource TextAccent}"
                                   FontAttributes="Bold"/>

                            <Label Text="Coach Dashboard"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMain}"/>

                            <Label x:Name="ActiveUserIdLabel"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSub}"/>
                     </VerticalStackLayout>

                     <Grid Grid.Column="1">

                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource InsetBg}"
                                    StrokeShape="RoundRectangle 23"
                                    VerticalOptions="Center">

                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer
                                                 Tapped="OnNotificationsClicked"/>
                                   </Border.GestureRecognizers>

                                   <Label Text="♙"
                                          FontSize="26"
                                          TextColor="{DynamicResource TextAccent}"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"/>
                            </Border>
                     </Grid>
              </Grid>

              <!-- Main content -->
              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18">

                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,0">
                                   <Label Text="YOUR CLASSES"
                                          FontSize="13"
                                          CharacterSpacing="2"
                                          FontAttributes="Bold"
                                          TextColor="{DynamicResource TextSub}"
                                          VerticalOptions="Center"/>

                                   <Label Grid.Column="1"
                                          x:Name="ClassCountLabel"
                                          Text="3 classes"
                                          FontSize="12"
                                          TextColor="{DynamicResource TextDim}"
                                          VerticalOptions="Center"/>
                            </Grid>

                            <!-- Class 1 -->
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnClass1Tapped"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="Auto,*,Auto"
                                         ColumnSpacing="14">

                                          <Border WidthRequest="48"
                                                  HeightRequest="48"
                                                  BackgroundColor="{DynamicResource AccentTint}"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 12"
                                                  VerticalOptions="Center">
                                                 <Label Text="01"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                          </Border>

                                          <VerticalStackLayout Grid.Column="1"
                                                               Spacing="5"
                                                               VerticalOptions="Center">
                                                 <Label Text="Class 1"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextMain}"/>
                                                 <Label Text="View enrolled students"
                                                        FontSize="12"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>

                                          <Button Grid.Column="2"
                                                  Text="›"
                                                  FontSize="32"
                                                  BackgroundColor="{DynamicResource TextAccent}"
                                                  TextColor="{DynamicResource PageBg}"
                                                  VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <!-- Class 2 -->
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnClass2Tapped"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="Auto,*,Auto"
                                         ColumnSpacing="14">

                                          <Border WidthRequest="48"
                                                  HeightRequest="48"
                                                  BackgroundColor="{DynamicResource AccentTint}"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 12"
                                                  VerticalOptions="Center">
                                                 <Label Text="02"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                          </Border>

                                          <VerticalStackLayout Grid.Column="1"
                                                               Spacing="5"
                                                               VerticalOptions="Center">
                                                 <Label Text="Class 2"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextMain}"/>
                                                 <Label Text="View enrolled students"
                                                        FontSize="12"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>

                                          <Button Grid.Column="2"
                                                  Text="›"
                                                  FontSize="32"
                                                  BackgroundColor="{DynamicResource TextAccent}"
                                                  TextColor="{DynamicResource PageBg}"
                                                  VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <!-- Class 3 -->
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnClass3Tapped"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="Auto,*,Auto"
                                         ColumnSpacing="14">

                                          <Border WidthRequest="48"
                                                  HeightRequest="48"
                                                  BackgroundColor="{DynamicResource AccentTint}"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 12"
                                                  VerticalOptions="Center">
                                                 <Label Text="03"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                          </Border>

                                          <VerticalStackLayout Grid.Column="1"
                                                               Spacing="5"
                                                               VerticalOptions="Center">
                                                 <Label Text="Class 3"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextMain}"/>
                                                 <Label Text="View enrolled students"
                                                        FontSize="12"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>

                                          <Button Grid.Column="2"
                                                  Text="›"
                                                  FontSize="32"
                                                  BackgroundColor="{DynamicResource TextAccent}"
                                                  TextColor="{DynamicResource PageBg}"
                                                  VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <!-- Classes saved in Supabase are added after the existing classes. -->
                            <VerticalStackLayout x:Name="ClassListLayout" Spacing="12">
                                   <BindableLayout.ItemTemplate>
                                          <DataTemplate x:DataType="models:Class">
                                                 <Border BackgroundColor="#1C1C1C"
                                                         Stroke="#343434"
                                                         StrokeThickness="1"
                                                         StrokeShape="RoundRectangle 16"
                                                         Padding="18">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                               <Border WidthRequest="48" HeightRequest="48"
                                                                       BackgroundColor="#332B12" StrokeThickness="0"
                                                                       StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                                      <Label Text="CL" FontSize="15" FontAttributes="Bold"
                                                                             TextColor="#F5C542" HorizontalOptions="Center"
                                                                             VerticalOptions="Center"/>
                                                               </Border>
                                                               <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                                      <Label Text="{Binding Name}" FontSize="18"
                                                                             FontAttributes="Bold" TextColor="White"/>
                                                                      <Label Text="View enrolled students" FontSize="12"
                                                                             TextColor="#999999"/>
                                                               </VerticalStackLayout>
                                                        </Grid>
                                                 </Border>
                                          </DataTemplate>
                                   </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Add actions -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  Margin="0,4,0,0">

                                   <Button Text="+  Add Class"
                                           Clicked="OnAddClassClicked"
                                           BackgroundColor="{DynamicResource TextAccent}"
                                           TextColor="{DynamicResource NavBg}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           CornerRadius="12"
                                           HeightRequest="58"/>

                                   <Button Grid.Column="1"
                                           Text="+  Add Student"
                                           Clicked="OnAddStudentClicked"
                                           BackgroundColor="{DynamicResource TextAccent}"
                                           TextColor="{DynamicResource PageBg}"
                                           BorderColor="{DynamicResource CardBorder}"
                                           BorderWidth="1"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           CornerRadius="12"
                                           HeightRequest="58"/>
                            </Grid>

                            <!-- Reports -->
                            <Button Text="Reports     ›"
                                    Clicked="OnReportsClicked"
                                    BackgroundColor="{DynamicResource TextAccent}"
                                    TextColor="{DynamicResource PageBg}"
                                    BorderColor="{DynamicResource CardBorder}"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    Margin="0,0,0,18"/>

                     </VerticalStackLayout>
              </ScrollView>

              <!-- Bottom navigation -->
              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*,*,*"
                    Padding="0,12,0,16"
                    BackgroundColor="{DynamicResource NavBg}">

                     <VerticalStackLayout Spacing="4">
                            <Button Text="🏠"
                                    FontSize="23"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnHomeClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Home"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextAccent}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4">
                            <Button Text="👑"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnLeaderboardClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Leaderboard"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="2"
                                          Spacing="4">
                            <Button Text="📊"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnMetricsClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Metrics"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="3"
                                          Spacing="4">
                            <Button Text="⚙️"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnSettingsClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Settings"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

              <Grid x:Name="AddStudentPopup"
                    IsVisible="False"
                    Grid.RowSpan="3"
                    BackgroundColor="{DynamicResource NavBg}"
                    Opacity="0.8">

                     <BoxView Color="#90000000">
                            <BoxView.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="CloseAddStudentPopup"/>
                            </BoxView.GestureRecognizers>
                     </BoxView>

                     <Border BackgroundColor="{DynamicResource CardBg}"
                             Stroke="{DynamicResource CardBorderBrush}"
                             StrokeThickness="1"
                             StrokeShape="RoundRectangle 20"
                             Padding="24"
                             WidthRequest="350"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

                            <VerticalStackLayout Spacing="16">

                                   <Label Text="ADD STUDENT"
                                          FontSize="20"
                                          FontAttributes="Bold"
                                          TextColor="{DynamicResource TextAccent}"
                                          HorizontalOptions="Center"/>

                                   <Picker x:Name="ClassPicker"
                                           Title="Select Class"
                                           TextColor="{DynamicResource TextMain}"
                                           TitleColor="{DynamicResource TextMuted}"
                                           BackgroundColor="{DynamicResource InsetBg}"/>

                                   <Editor x:Name="StudentIdEntry"
                                          Placeholder="Enter student IDs (one per line)"
                                          PlaceholderColor="{DynamicResource TextDim}"
                                          TextColor="{DynamicResource TextMain}"
                                          BackgroundColor="{DynamicResource InsetBg}"
                                          HeightRequest="120"
                                          AutoSize="TextChanges"/>

                                   <Button Text="Add Student"
                                           Clicked="OnStudentIdEntryCompleted"
                                           BackgroundColor="{DynamicResource TextAccent}"
                                           TextColor="{DynamicResource PageBg}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           CornerRadius="12"
                                           HeightRequest="50"
                                           HorizontalOptions="Center"
                                           WidthRequest="180"/>

                                   <Button Text="Cancel"
                                           Clicked="CloseAddStudentPopup"
                                           BackgroundColor="{DynamicResource DividerLine}"
                                           TextColor="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           CornerRadius="12"
                                           HeightRequest="42"/>
                            </VerticalStackLayout>
                     </Border>
              </Grid>


       </Grid>
</ContentPage>
