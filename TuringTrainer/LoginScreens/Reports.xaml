<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TuringTrainer.Reports"
    Title="Reports"
    BackgroundColor="#0A0A0A">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,30"
            Spacing="22">

            <!-- Page Title -->
            <Label
                Text="Reports"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#FFD600" />

            <Label
                Text="Generate and customize athlete performance reports."
                FontSize="14"
                TextColor="#A0A0A0"
                Margin="0,-12,0,10" />

            <!-- Report Type -->
            <Label
                Text="REPORT TYPE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="White" />

            <!-- By Class -->
            <Border
                BackgroundColor="#151515"
                Stroke="#333333"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="12">

                    <RadioButton
                        Content="By Class"
                        GroupName="ReportType"
                        TextColor="White"
                        IsChecked="True" />

                    <Picker
                        Title="Select Class"
                        TitleColor="#A0A0A0"
                        TextColor="White"
                        BackgroundColor="#222222">

                        <Picker.Items>
                            <x:String>Class 1</x:String>
                            <x:String>Class 2</x:String>
                            <x:String>Class 3</x:String>
                            <x:String>All Classes</x:String>
                        </Picker.Items>

                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- By Sport -->
            <Border
                BackgroundColor="#151515"
                Stroke="#333333"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="12">

                    <RadioButton
                        Content="By Sport"
                        GroupName="ReportType"
                        TextColor="White" />

                    <Picker
                        Title="Select Sport"
                        TitleColor="#A0A0A0"
                        TextColor="White"
                        BackgroundColor="#222222">

                        <Picker.Items>
                            <x:String>Football</x:String>
                            <x:String>Basketball</x:String>
                            <x:String>Soccer</x:String>
                            <x:String>Baseball</x:String>
                            <x:String>Track &amp; Field</x:String>
                            <x:String>All Sports</x:String>
                        </Picker.Items>

                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- Custom Filter -->
            <Border
                BackgroundColor="#151515"
                Stroke="#333333"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="12">

                    <RadioButton
                        Content="Custom Filter"
                        GroupName="ReportType"
                        TextColor="White" />

                    <Label
                        Text="Choose specific criteria for your report."
                        TextColor="#A0A0A0"
                        FontSize="12" />

                    <Picker
                        Title="Select Class"
                        TitleColor="#A0A0A0"
                        TextColor="White"
                        BackgroundColor="#222222">

                        <Picker.Items>
                            <x:String>All Classes</x:String>
                            <x:String>Class 1</x:String>
                            <x:String>Class 2</x:String>
                            <x:String>Class 3</x:String>
                        </Picker.Items>

                    </Picker>

                    <Picker
                        Title="Select Sport"
                        TitleColor="#A0A0A0"
                        TextColor="White"
                        BackgroundColor="#222222">

                        <Picker.Items>
                            <x:String>All Sports</x:String>
                            <x:String>Football</x:String>
                            <x:String>Basketball</x:String>
                            <x:String>Soccer</x:String>
                            <x:String>Baseball</x:String>
                            <x:String>Track &amp; Field</x:String>
                        </Picker.Items>

                    </Picker>

                    <Picker
                        Title="Select Metric"
                        TitleColor="#A0A0A0"
                        TextColor="White"
                        BackgroundColor="#222222">

                        <Picker.Items>
                            <x:String>All Metrics</x:String>
                            <x:String>Bench Press</x:String>
                            <x:String>Squat</x:String>
                            <x:String>Power Clean</x:String>
                            <x:String>Personal Records</x:String>
                            <x:String>Workout Completion</x:String>
                        </Picker.Items>

                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- Date Range -->
            <Label
                Text="DATE RANGE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="White" />

            <Border
                BackgroundColor="#151515"
                Stroke="#333333"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Start Date"
                        TextColor="#A0A0A0"
                        FontSize="13" />

                    <DatePicker
                        x:Name="StartDatePicker"
                        TextColor="White"
                        BackgroundColor="#222222"
                        Format="MMM dd, yyyy" />

                    <Label
                        Text="End Date"
                        TextColor="#A0A0A0"
                        FontSize="13" />

                    <DatePicker
                        x:Name="EndDatePicker"
                        TextColor="White"
                        BackgroundColor="#222222"
                        Format="MMM dd, yyyy" />

                </VerticalStackLayout>
            </Border>

            <!-- Generate Report -->
            <Button
                Text="GENERATE REPORT"
                FontAttributes="Bold"
                FontSize="16"
                BackgroundColor="#FFD600"
                TextColor="#0A0A0A"
                CornerRadius="12"
                HeightRequest="58"
                Margin="0,10,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
