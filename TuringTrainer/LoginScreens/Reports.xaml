<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TuringTrainer.Reports"
    Title="Reports"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,30"
            Spacing="22">

            <Label
                Text="Reports"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{DynamicResource TextAccent}" />

            <Label
                Text="Generate and customize athlete performance reports."
                FontSize="14"
                TextColor="{DynamicResource TextSub}"
                Margin="0,-12,0,10" />

            <Label
                Text="REPORT TYPE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="{DynamicResource TextMain}" />

            <!-- By Class -->
            <Border
                BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardBorderBrush}"
                StrokeShape="RoundRectangle 12"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <RadioButton
                        x:Name="ByClassRadio"
                        Content="By Class"
                        GroupName="ReportType"
                        TextColor="{DynamicResource TextMain}"
                        IsChecked="True" />
                    <Picker
                        x:Name="ClassPicker"
                        Title="Select Class"
                        TitleColor="{DynamicResource TextSub}"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}" />
                </VerticalStackLayout>
            </Border>

            <!-- By Sport -->
            <Border
                BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardBorderBrush}"
                StrokeShape="RoundRectangle 12"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <RadioButton
                        x:Name="BySportRadio"
                        Content="By Sport"
                        GroupName="ReportType"
                        TextColor="{DynamicResource TextMain}" />
                    <Picker
                        x:Name="SportPicker"
                        Title="Select Sport"
                        TitleColor="{DynamicResource TextSub}"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}" />
                </VerticalStackLayout>
            </Border>

            <!-- Custom Filter -->
            <Border
                BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardBorderBrush}"
                StrokeShape="RoundRectangle 12"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <RadioButton
                        x:Name="CustomRadio"
                        Content="Custom Filter"
                        GroupName="ReportType"
                        TextColor="{DynamicResource TextMain}" />
                    <Label
                        Text="Choose a class and a sport together."
                        TextColor="{DynamicResource TextSub}"
                        FontSize="12" />
                    <Picker
                        x:Name="CustomClassPicker"
                        Title="Select Class"
                        TitleColor="{DynamicResource TextSub}"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}" />
                    <Picker
                        x:Name="CustomSportPicker"
                        Title="Select Sport"
                        TitleColor="{DynamicResource TextSub}"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}" />
                </VerticalStackLayout>
            </Border>

            <!-- Date Range -->
            <Label
                Text="DATE RANGE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="{DynamicResource TextMain}" />

            <Border
                BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardBorderBrush}"
                StrokeShape="RoundRectangle 12"
                Padding="18">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Start Date" TextColor="{DynamicResource TextSub}" FontSize="13" />
                    <DatePicker
                        x:Name="StartDatePicker"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}"
                        Format="MMM dd, yyyy" />
                    <Label Text="End Date" TextColor="{DynamicResource TextSub}" FontSize="13" />
                    <DatePicker
                        x:Name="EndDatePicker"
                        TextColor="{DynamicResource TextMain}"
                        BackgroundColor="{DynamicResource InsetBg}"
                        Format="MMM dd, yyyy" />
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="StatusLabel"
                FontSize="13"
                TextColor="{AppThemeBinding Light=#C62828, Dark=#FF8A80}"
                IsVisible="False" />

            <Button
                x:Name="GenerateButton"
                Text="GENERATE REPORT"
                FontAttributes="Bold"
                FontSize="16"
                BackgroundColor="{DynamicResource TextAccent}"
                TextColor="{DynamicResource PageBg}"
                CornerRadius="12"
                HeightRequest="58"
                Margin="0,10,0,10"
                Clicked="OnGenerateClicked" />

            <ActivityIndicator
                x:Name="Spinner"
                IsRunning="False"
                IsVisible="False"
                Color="{DynamicResource TextAccent}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
