<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuringTrainer.LoginPage"
             Background="{DynamicResource PageBgBrush}">
             

    <Grid>
		<VerticalStackLayout
			Padding="30"
			Spacing="18"
			VerticalOptions="Center">

			<Label
				Text="LOGIN"
				FontSize="28"
				FontAttributes="Bold"
				TextColor="{DynamicResource TextAccent}"
				HorizontalOptions="Center"
				Margin="0,0,0,12" />

			<Entry
				x:Name="EmailEntry"
				Placeholder="Email"
				TextColor="{DynamicResource TextMain}"
				PlaceholderColor="{DynamicResource TextSub}"
				Background="{DynamicResource InsetBgBrush}" />


			<Entry
				x:Name="PasswordEntry"
				Placeholder="Password"
				IsPassword="True"
				TextColor="{DynamicResource TextMain}"
				PlaceholderColor="{DynamicResource TextSub}"
				Background="{DynamicResource InsetBgBrush}" />

			<Button
				Text="LOGIN"
				FontAttributes="Bold"
				Clicked="LoginButton_Clicked"
				Background="{DynamicResource TextAccentBrush}"
				TextColor="{DynamicResource PageBg}"
				HeightRequest="58"
				Margin="0,10,0,0" />

            <Button
                Text="Forgot Password?"
                FontAttributes="Bold"
                Background="{DynamicResource TextAccentBrush}"
                TextColor="{DynamicResource PageBg}"
                HeightRequest="58"
                Margin="0,10,0,0" />
		</VerticalStackLayout>
	</Grid>

</ContentPage>
