<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuringTrainer.ClassIIPage"
             Background="{DynamicResource PageBgBrush}"
             Title="Class 2"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Pages/RoutineTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20,12,20,0"
          RowSpacing="20">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Padding="0,12,0,0">


            <VerticalStackLayout Grid.Column="1"
                                 Spacing="10">
                <Label Text="TURINGTRAINER"
                       FontSize="12"
                       CharacterSpacing="3"
                       TextColor="{DynamicResource TextAccent}"
                       FontAttributes="Bold"/>

                <Label Text="Class 2"
                       TextColor="{DynamicResource TextMain}"
                       FontSize="27"
                       FontAttributes="Bold"/>

                <Label Text="COLLEGE SPORTS"
                       TextColor="{DynamicResource TextSub}"
                       CharacterSpacing="2"
                       FontAttributes="Bold"
                       FontSize="13"/>

            </VerticalStackLayout>
        </Grid>

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="10">
            <Button x:Name="SportsTab"
                    Text="Sports"
                    Clicked="OnSportsTabClicked"
                    BackgroundColor="{DynamicResource AccentTint}"
                    TextColor="{DynamicResource TextAccent}"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="46"
                    Padding="24,0"/>
            <Button x:Name="RoutinesTab"
                    Text="Routines"
                    Clicked="OnRoutinesTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextMuted}"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="46"
                    Padding="24,0"/>
            <Button x:Name="MembersTab"
                    Text="Members"
                    Clicked="OnMembersTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextMuted}"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="46"
                    Padding="24,0"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2"
                        x:Name="SportsList"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardBorderBrush}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="18"
                            Margin="0">


                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="14">

                            <Label Text="{Binding .}"
                                   TextColor="{DynamicResource TextMain}"
                                   FontSize="18"
                                   VerticalOptions="Center"/>

                            <Button Grid.Column="1"
                                    Text="›"
                                    FontSize="32"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PageBg}"
                                    BackgroundColor="{DynamicResource TextAccent}"
                                    CornerRadius="12"
                                    WidthRequest="55"
                                    HeightRequest="55"
                                    Padding="0"
                                    Clicked="OnSportClicked"
                                    CommandParameter="{Binding .}"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid Grid.Row="2"
              RowDefinitions="Auto,*"
              RowSpacing="10">

            <SearchBar Grid.Row="0"
                       x:Name="MemberSearchBar"
                       Placeholder="Search members..."
                       TextChanged="OnMemberSearchTextChanged"
                       IsVisible="False"
                       BackgroundColor="#332B12"
                       TextColor="White"
                       PlaceholderColor="#999999"/>

            <CollectionView Grid.Row="1"
                            x:Name="MembersList"
                            IsVisible="False"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardBorderBrush}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="18"
                                Margin="0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMemberClicked"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="14">

                                <HorizontalStackLayout Spacing="5"
                                                       VerticalOptions="Center">

                                    <Border WidthRequest="54"
                                            HeightRequest="54"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 27"
                                            VerticalOptions="Center">

                                        <Image Source="{Binding AvatarImage}"
                                               WidthRequest="54"
                                               HeightRequest="54"
                                               Aspect="AspectFill"/>
                                    </Border>
                                    <Label Text="{Binding FirstName}"
                                           TextColor="{DynamicResource TextMain}"
                                           FontSize="18"
                                           VerticalOptions="Center"/>

                                    <Label Text="{Binding LastName}"
                                           TextColor="{DynamicResource TextMain}"
                                           FontSize="18"
                                           VerticalOptions="Center"/>

                                </HorizontalStackLayout>


                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <CollectionView Grid.Row="2"
                        x:Name="RoutinesList"
                        IsVisible="False"
                        SelectionMode="Single"
                        SelectionChanged="OnRoutineSelected"
                        ItemTemplate="{StaticResource RoutineTemplate}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
        </CollectionView>
    </Grid>
</ContentPage>