<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="TuringTrainer.Settings.Settings"
       BackgroundColor="{DynamicResource PageBg}"
       Shell.NavBarIsVisible="False">

       <Grid>

              <Grid RowDefinitions="Auto,*,Auto"
                    Padding="20,12,20,0">

                     <Grid Grid.Row="0"
                           ColumnDefinitions="Auto,*"
                           ColumnSpacing="14"
                           Padding="0,12,0,24">

                            <Label Grid.Column="1"
                                   Text="Settings"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextAccent}"
                                   VerticalOptions="Center"/>
                     </Grid>

              <!-- Main content -->
              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18">

                                   <Border BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="18">

                                          <VerticalStackLayout Spacing="14">

                                                 <Border WidthRequest="100"
                                                        HeightRequest="100"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 50"
                                                        HorizontalOptions="Center">
                                                 <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnProfilePictureTapped"/>
                                                 </Border.GestureRecognizers>
                                                 <Image x:Name="ProfileImage"
                                                        Source="blank_profile_picture.png"
                                                        Aspect="AspectFill"/>
                                                 </Border>

                                                 <Grid ColumnDefinitions="*, Auto">
                                                        <Label Text="ACCOUNT INFORMATION"
                                                               FontSize="13"
                                                               CharacterSpacing="2"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource TextSub}"/>

                                                        <Button Grid.Column="1"
                                                                Text="✎"
                                                                FontSize="22"
                                                                WidthRequest="42"
                                                                HeightRequest="42"
                                                                Padding="0"
                                                                BackgroundColor="{DynamicResource InsetBg}"
                                                                TextColor="{DynamicResource TextAccent}"
                                                                CornerRadius="10"
                                                                Clicked="OnEditClicked"/>
                                                 </Grid>

                                                 <Label Text="First Name"
                                                        FontSize="13"
                                                        TextColor="{DynamicResource TextMuted}"/>

                                                 <Border BackgroundColor="{DynamicResource InsetBg}"
                                                         StrokeThickness="0"
                                                         Padding="12,8">

                                                        <Label x:Name="FirstNameLabel"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                 </Border>

                                                 <Label Text="Middle Initial"
                                                        FontSize="13"
                                                        TextColor="{DynamicResource TextMuted}"/>

                                                 <Border BackgroundColor="{DynamicResource InsetBg}"
                                                         StrokeThickness="0"
                                                         Padding="12,8">

                                                        <Label x:Name="MiddleInitialLabel"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                 </Border>

                                                 <Label Text="Last Name"
                                                        FontSize="13"
                                                        TextColor="{DynamicResource TextMuted}"/>

                                                 <Border BackgroundColor="{DynamicResource InsetBg}"
                                                         StrokeThickness="0"
                                                         Padding="12,8">

                                                        <Label x:Name="LastNameLabel"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                 </Border>

                                                 <Label Text="Email"
                                                        FontSize="13"
                                                        TextColor="{DynamicResource TextMuted}"/>

                                                 <Border BackgroundColor="{DynamicResource InsetBg}"
                                                         StrokeThickness="0"
                                                         Padding="12,8">

                                                        <Label x:Name="EmailLabel"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                 </Border>

                                                 <Label Text="Your email is linked to your login account"
                                                        FontSize="13"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="18">

                                          <Grid ColumnDefinitions="*,Auto"
                                                ColumnSpacing="14">

                                                 <VerticalStackLayout Spacing="4"
                                                                      VerticalOptions="Center">
                                                        <Label Text="Appearance"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                        <Label Text="Light / Dark / System"
                                                               FontSize="12"
                                                               TextColor="{DynamicResource TextMuted}"/>
                                                 </VerticalStackLayout>

                                                 <Picker Grid.Column="1"
                                                         x:Name="ThemePicker"
                                                         WidthRequest="130"
                                                         TextColor="{DynamicResource TextMain}"
                                                         TitleColor="{DynamicResource TextMuted}"
                                                         BackgroundColor="{DynamicResource InsetBg}"
                                                         SelectedIndexChanged="OnThemeChanged"/>
                                          </Grid>
                                   </Border>

                                   <Border BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="18">

                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnHelpTapped"/>
                                          </Border.GestureRecognizers>

                                          <Grid ColumnDefinitions="*,Auto">
                                                 <VerticalStackLayout Spacing="4"
                                                                      VerticalOptions="Center">
                                                        <Label Text="Help"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                        <Label Text="FAQs and support"
                                                               FontSize="12"
                                                               TextColor="{DynamicResource TextMuted}"/>
                                                 </VerticalStackLayout>

                                                 <Label Grid.Column="1"
                                                        Text="›"
                                                        FontSize="28"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Border>

                                   <Border BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="18">

                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                                          </Border.GestureRecognizers>

                                          <Grid ColumnDefinitions="*,Auto">
                                                 <VerticalStackLayout Spacing="4"
                                                                      VerticalOptions="Center">
                                                        <Label Text="Feedback"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource TextMain}"/>
                                                        <Label Text="Share your thoughts"
                                                               FontSize="12"
                                                               TextColor="{DynamicResource TextMuted}"/>
                                                 </VerticalStackLayout>

                                                 <Label Grid.Column="1"
                                                        Text="›"
                                                        FontSize="28"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Border>

                                   <Button Text="Log Out"
                                           Clicked="OnLogoutClicked"
                                           BackgroundColor="Transparent"
                                           TextColor="#E05252"
                                           BorderColor="#E05252"
                                           BorderWidth="1"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           CornerRadius="12"
                                           HeightRequest="52"
                                           Margin="0,0,0,18"/>

                            </VerticalStackLayout>
                     </ScrollView>

                     <Grid Grid.Row="2"
                           ColumnDefinitions="*,*,*,*"
                           Padding="0,12,0,16"
                           BackgroundColor="{DynamicResource NavBg}">

                            <VerticalStackLayout Spacing="4">
                                   <Button Text="🏠"
                                           FontSize="23"
                                           TextColor="{DynamicResource TextDim}"
                                           Clicked="OnHomeClicked"
                                           HorizontalOptions="Center"/>
                                   <Label Text="Home"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                   <Button Text="👑"
                                           FontSize="22"
                                           TextColor="{DynamicResource TextDim}"
                                           Clicked="OnLeaderboardClicked"
                                           HorizontalOptions="Center"/>
                                   <Label Text="Leaderboard"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="4">
                                   <Button Text="📊"
                                           FontSize="22"
                                           TextColor="{DynamicResource TextDim}"
                                           Clicked="OnMetricsClicked"
                                           HorizontalOptions="Center"/>
                                   <Label Text="Metrics"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3"
                                                 Spacing="4">
                                   <Button Text="⚙️"
                                           FontSize="22"
                                           TextColor="{DynamicResource TextAccent}"
                                           HorizontalOptions="Center"/>
                                   <Label Text="Settings"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextAccent}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                     </Grid>
              </Grid>
              <!-- Edit Account Popup -->
              <Grid x:Name="EditAccountPopup"
                    IsVisible="False"
                    BackgroundColor="#CC000000">

                     <Border BackgroundColor="{DynamicResource CardBg}"
                             Stroke="{DynamicResource CardBorderBrush}"
                             StrokeThickness="1"
                             StrokeShape="RoundRectangle 16"
                             Padding="24"
                             Margin="20"
                             MaximumWidthRequest="450"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

                            <ScrollView MaximumHeightRequest="600">

                                   <VerticalStackLayout Spacing="14">

                                          <Label Text="Edit Account Information"
                                                 FontSize="22"
                                                 FontAttributes="Bold"
                                                 TextColor="#A5A5A5"/>

                                          <VerticalStackLayout Spacing="4">
                                                 <Label x:Name="OrganizationNameLabel"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="White"/>
                                                 <Label x:Name="OrganizationIdLabel"
                                                        FontSize="11"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>

                                          <Entry x:Name="NameEntry"
                                                 Placeholder="Name"
                                                 PlaceholderColor="silver"
                                                 TextColor="#FF8A8888"
                                                 BackgroundColor="#262626"/>

                                          <Entry x:Name="EmailEntry"
                                                 Placeholder="Email"
                                                 PlaceholderColor="Silver"
                                                 TextColor="#FF8A8888"
                                                 BackgroundColor="#262626"
                                                 Keyboard="Email"/>

                                          <Label Text="First Name"
                                                 TextColor="{DynamicResource TextMuted}"/>

                                          <Entry x:Name="FirstNameEntry"
                                                 PlaceholderColor="{DynamicResource TextMuted}" Placeholder="First Name"
                                                 TextColor="{DynamicResource TextMain}"
                                                 BackgroundColor="{DynamicResource InsetBg}"/>

                                          <Label Text="Middle Initial"
                                                 TextColor="{DynamicResource TextMuted}"/>

                                          <Entry x:Name="MiddleInitialEntry"
                                                 PlaceholderColor="{DynamicResource TextMuted}" Placeholder="Middle Initial"
                                                 MaxLength="1"
                                                 TextColor="{DynamicResource TextMain}"
                                                 BackgroundColor="{DynamicResource InsetBg}"/>

                                          <Label Text="Last Name"
                                                 TextColor="{DynamicResource TextMuted}"/>

                                          <Entry x:Name="LastNameEntry"
                                                 PlaceholderColor="{DynamicResource TextMuted}" Placeholder="Last Name"
                                                 TextColor="{DynamicResource TextMain}"
                                                 BackgroundColor="{DynamicResource InsetBg}"/>

                                          <Grid ColumnDefinitions="*,*"
                                                ColumnSpacing="12">

                                                 <Button Text="Cancel"
                                                         Clicked="OnCancelClicked"
                                                         BackgroundColor="{DynamicResource CardBorder}"
                                                         TextColor="{DynamicResource TextMain}"/>

                                                 <Button Grid.Column="1"
                                                         x:Name="SaveAccountButton"
                                                         Text="Save Changes"
                                                         Clicked="OnSaveClicked"
                                                         BackgroundColor="{DynamicResource TextAccent}"
                                                         TextColor="{DynamicResource NavBg}"/>

                                          </Grid>

                                   </VerticalStackLayout>
                            </ScrollView>
                     </Border>
              </Grid>
       </Grid>
</ContentPage>