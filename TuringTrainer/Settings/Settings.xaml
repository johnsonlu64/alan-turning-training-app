<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="TuringTrainer.Settings.Settings"
       BackgroundColor="#101010"
       Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*,Auto"
             Padding="20,12,20,0">

              <!-- Header -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="14"
                    Padding="0,12,0,24">

                     <Button Text="‹"
                             FontSize="32"
                             TextColor="#F5C542"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             VerticalOptions="Center"
                             Padding="0"
                             WidthRequest="40"/>

                     <Label Grid.Column="1"
                            Text="Settings"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center"/>
              </Grid>

              <!-- Main content -->
              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18">

                            <!-- Account information -->
                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="14">

                                          <Label Text="ACCOUNT INFORMATION"
                                                 FontSize="13"
                                                 CharacterSpacing="2"
                                                 FontAttributes="Bold"
                                                 TextColor="#A5A5A5"/>

                                          <Entry x:Name="NameEntry"
                                                 Placeholder="Name"
                                                 PlaceholderColor="silver"
                                                 TextColor="#FF8A8888"
                                                 BackgroundColor="#262626"/>

                                          <Entry x:Name="EmailEntry"
                                                 Placeholder="Email"
                                                 PlaceholderColor="Silver"
                                                 TextColor="#FF8A8888"
                                                 BackgroundColor="#262626"
                                                 Keyboard="Email"/>
                                   </VerticalStackLayout>
                            </Border>

                            <!-- Theme -->
                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <Grid ColumnDefinitions="*,Auto"
                                         ColumnSpacing="14">

                                          <VerticalStackLayout Spacing="4"
                                                               VerticalOptions="Center">
                                                 <Label Text="Appearance"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="White"/>
                                                 <Label Text="Light / Dark / System"
                                                        FontSize="12"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>

                                          <Picker Grid.Column="1"
                                                  x:Name="ThemePicker"
                                                  WidthRequest="130"
                                                  TextColor="White"
                                                  TitleColor="#999999"
                                                  BackgroundColor="#262626"
                                                  SelectedIndexChanged="OnThemeChanged"/>
                                   </Grid>
                            </Border>

                            <!-- Help -->
                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnHelpTapped"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="*,Auto">
                                          <VerticalStackLayout Spacing="4"
                                                               VerticalOptions="Center">
                                                 <Label Text="Help"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="White"/>
                                                 <Label Text="FAQs and support"
                                                        FontSize="12"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>

                                          <Label Grid.Column="1"
                                                 Text="›"
                                                 FontSize="28"
                                                 TextColor="#F5C542"
                                                 VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <!-- Feedback -->
                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="*,Auto">
                                          <VerticalStackLayout Spacing="4"
                                                               VerticalOptions="Center">
                                                 <Label Text="Feedback"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="White"/>
                                                 <Label Text="Share your thoughts"
                                                        FontSize="12"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>

                                          <Label Grid.Column="1"
                                                 Text="›"
                                                 FontSize="28"
                                                 TextColor="#F5C542"
                                                 VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <!-- Save -->
                            <Button Text="Save Changes"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#F5C542"
                                    TextColor="#151515"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="52"/>

                            <!-- Logout -->
                            <Button Text="Log Out"
                                    Clicked="OnLogoutClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#E05252"
                                    BorderColor="#E05252"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    Margin="0,0,0,18"/>

                     </VerticalStackLayout>
              </ScrollView>

              <!-- Bottom navigation -->
              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*,*,*"
                    Padding="0,12,0,16"
                    BackgroundColor="#151515">

                     <VerticalStackLayout Spacing="4">
                            <Button Text="🏠"
                                    FontSize="23"
                                    TextColor="#777777"
                                    Clicked="OnHomeClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Home"
                                   FontSize="10"
                                   TextColor="#777777"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4">
                            <Button Text="👑"
                                    FontSize="22"
                                    TextColor="#777777"
                                    Clicked="OnLeaderboardClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Leaderboard"
                                   FontSize="10"
                                   TextColor="#777777"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="2"
                                          Spacing="4">
                            <Button Text="📊"
                                    FontSize="22"
                                    TextColor="#777777"
                                    Clicked="OnMetricsClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Metrics"
                                   FontSize="10"
                                   TextColor="#777777"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="3"
                                          Spacing="4">
                            <Button Text="⚙️"
                                    FontSize="22"
                                    TextColor="#F5C542"
                                    HorizontalOptions="Center"/>
                            <Label Text="Settings"
                                   FontSize="10"
                                   TextColor="#F5C542"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>