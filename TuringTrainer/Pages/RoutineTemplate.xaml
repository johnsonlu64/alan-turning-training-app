<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:TuringTrainer.Pages">

    <!-- The routine row, shared by the routines screen and the class screens. -->
    <DataTemplate x:Key="RoutineTemplate"
            x:DataType="pages:Routine">
        <Border BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardBorderBrush}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">
            <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="14">

                <Border WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{DynamicResource AccentTint}"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">
                    <Label Text="{Binding Index}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                        Spacing="5"
                        VerticalOptions="Center">
                    <Label Text="{Binding Title}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMain}"/>
                </VerticalStackLayout>

            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
