<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:TuringTrainer.Pages"
             x:Class="TuringTrainer.Pages.AnchorPickerPage"
             Title="Choose Anchor"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="AnchorTemplate" x:DataType="pages:AnchorOption">
            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="{DynamicResource CardBorderBrush}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Name}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextAccent}" />
                        <Label Text="{Binding Detail}"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="+"
                            Style="{StaticResource StepButton}"
                            Clicked="OnPickClicked"
                            CommandParameter="{Binding .}" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,12,20,20" RowSpacing="16">

        <pages:PageHeader x:Name="Header"
                          Title="Choose Anchor" />

        <Label Grid.Row="1"
               Text="Pick the exercise this one scales from."
               FontSize="12"
               TextColor="{DynamicResource TextMuted}" />

        <CollectionView x:Name="OptionsList"
                        Grid.Row="2"
                        ItemTemplate="{StaticResource AnchorTemplate}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <Button Grid.Row="3"
                Text="CANCEL"
                Clicked="OnCancelClicked"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextMuted}"
                BorderColor="{DynamicResource CardBorder}"
                BorderWidth="1"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="52" />
    </Grid>
</ContentPage>
