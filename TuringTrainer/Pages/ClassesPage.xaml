<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TuringTrainer.Models"
             x:Class="TuringTrainer.ClassesPage"
             Background="{DynamicResource PageBgBrush}"
             Title="Classes"
             Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*, Auto"
             Padding="20,12,20,0"
             RowSpacing="16">
              <!-- Header -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Padding="0,12,0,24">

                     <VerticalStackLayout Spacing="4">
                            <Label Text="TURINGTRAINER"
                                   FontSize="12"
                                   CharacterSpacing="3"
                                   TextColor="{DynamicResource TextAccent}"
                                   FontAttributes="Bold"/>

                            <Label Text="Classes"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMain}"/>
                     </VerticalStackLayout>

              </Grid>


              <!-- Main content -->
              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18">

                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,0">
                                   <Label Text="YOUR CLASSES"
                                          FontSize="13"
                                          CharacterSpacing="2"
                                          FontAttributes="Bold"
                                          TextColor="{DynamicResource TextSub}"
                                          VerticalOptions="Center"/>

                                   <Label Grid.Column="1"
                                          x:Name="ClassCountLabel"
                                          Text="0 classes"
                                          FontSize="12"
                                          TextColor="{DynamicResource TextDim}"
                                          VerticalOptions="Center"/>
                            </Grid>

                            <!-- Classes from Supabase -->
                            <VerticalStackLayout x:Name="ClassListLayout"
                                                 Spacing="12">
                                   <BindableLayout.ItemTemplate>
                                          <DataTemplate x:DataType="models:Class">
                                                 <Border BackgroundColor="{DynamicResource CardBg}"
                                                         Stroke="{DynamicResource CardBorderBrush}"
                                                         StrokeThickness="1"
                                                         StrokeShape="RoundRectangle 16"
                                                         Padding="18">

                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Tapped="OnClassTapped"/>
                                                        </Border.GestureRecognizers>

                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="14">

                                                               <Border WidthRequest="48"
                                                                       HeightRequest="48"
                                                                       BackgroundColor="{DynamicResource AccentTint}"
                                                                       StrokeThickness="0"
                                                                       StrokeShape="RoundRectangle 12"
                                                                       VerticalOptions="Center">

                                                                      <Label Text="CL"
                                                                             FontSize="15"
                                                                             FontAttributes="Bold"
                                                                             TextColor="{DynamicResource TextAccent}"
                                                                             HorizontalOptions="Center"
                                                                             VerticalOptions="Center"/>
                                                               </Border>

                                                               <VerticalStackLayout Grid.Column="1"
                                                                                    Spacing="5"
                                                                                    VerticalOptions="Center">

                                                                      <Label Text="{Binding Name}"
                                                                             FontSize="18"
                                                                             FontAttributes="Bold"
                                                                             TextColor="{DynamicResource TextMain}"/>

                                                                      <Label Text="View enrolled students"
                                                                             FontSize="12"
                                                                             TextColor="{DynamicResource TextMuted}"/>

                                                               </VerticalStackLayout>
                                                        </Grid>
                                                 </Border>
                                          </DataTemplate>
                                   </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                     </VerticalStackLayout>
              </ScrollView>
              <!-- Bottom navigation -->
              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*,*,*"
                    Padding="0,12,0,16"
                    BackgroundColor="{DynamicResource NavBg}">

                     <VerticalStackLayout Spacing="4">
                            <Button Text="🏠"
                                    FontSize="23"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnHomeClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Home"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextAccent}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4">
                            <Button Text="👑"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnLeaderboardClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Leaderboard"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="2"
                                          Spacing="4">
                            <Button Text="📊"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnMetricsClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Metrics"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Column="3"
                                          Spacing="4">
                            <Button Text="⚙️"
                                    FontSize="22"
                                    TextColor="{DynamicResource PageBg}"
                                    Clicked="OnSettingsClicked"
                                    HorizontalOptions="Center"/>
                            <Label Text="Settings"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDim}"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>