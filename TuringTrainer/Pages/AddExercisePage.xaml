<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:TuringTrainer.Pages"
             x:Class="TuringTrainer.Pages.AddExercisePage"
             Title="Add Exercise"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="LibraryTemplate" x:DataType="pages:LibraryEntry">
            <Border BackgroundColor="#1C1C1C"
                    Stroke="#343434"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Name}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF" />
                        <Label Text="{Binding Category}"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="#999999" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="+"
                            Style="{StaticResource StepButton}"
                            Clicked="OnAddClicked"
                            CommandParameter="{Binding .}" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,12,20,20" RowSpacing="16">

        <pages:PageHeader x:Name="Header"
                          Title="Add Exercise" />

        <Label Grid.Row="1"
               Text="Pick an exercise to add to the routine."
               FontSize="12"
               TextColor="#999999" />

        <CollectionView x:Name="LibraryList"
                        Grid.Row="2"
                        ItemTemplate="{StaticResource LibraryTemplate}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <Button Grid.Row="3"
                Text="CANCEL"
                Clicked="OnCancelClicked"
                BackgroundColor="Transparent"
                TextColor="#999999"
                BorderColor="#343434"
                BorderWidth="1"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="52" />
    </Grid>
</ContentPage>
