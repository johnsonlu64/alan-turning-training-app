<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:TuringTrainer.Pages"
             x:Class="TuringTrainer.Pages.RoutinesPage"
             Title="My Routines"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RoutineTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto"
            Padding="20,12,20,0"
            RowSpacing="16">

        <pages:PageHeader x:Name="Header"
                          Title="My Routines"
                          RightLabel="3 ROUTINES"/>

        <CollectionView x:Name="RoutinesList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnRoutineSelected"
                        ItemTemplate="{StaticResource RoutineTemplate}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                        ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Join Group"
                Clicked="OnJoinGroupClicked"
                BackgroundColor="Transparent"
                TextColor="#F5C542"
                BorderColor="#343434"
                BorderWidth="1"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="52"
                Margin="0,16,0,20"/>
    </Grid>
</ContentPage>
