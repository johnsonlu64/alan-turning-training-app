<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="TuringTrainer.MetricsPage"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Metrics Page"
             Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*,Auto"
             Padding="20,12,20,0"
             RowSpacing="16">

              <Grid ColumnDefinitions="Auto,*, Auto"
                    ColumnSpacing="12"
                    Padding="0,12,0,0">

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4"
                                          VerticalOptions="Center">

                            <Label Text="TURINGTRAINER"
                                   FontSize="12"
                                   CharacterSpacing="3"
                                   TextColor="{DynamicResource TextAccent}"
                                   FontAttributes="Bold"/>

                            <Label Text="Athlete Metrics"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMain}"/>
                     </VerticalStackLayout>
              </Grid>

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18"
                                          Padding="0,0,0,24">

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <Grid ColumnDefinitions="Auto,*"
                                         ColumnSpacing="14">

                                          <Border WidthRequest="54"
                                                  HeightRequest="54"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 27"
                                                  VerticalOptions="Center">

                                                 <Image x:Name="AthleteAvatar"
                                                        WidthRequest="54"
                                                        HeightRequest="54"
                                                        Aspect="AspectFill"/>
                                          </Border>

                                          <VerticalStackLayout Grid.Column="1"
                                                               Spacing="5"
                                                               VerticalOptions="Center">

                                                 <Label x:Name="AthleteNameLabel"
                                                        Text="{Binding MemberName}"
                                                        FontSize="20"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextMain}"/>

                                                 <Label x:Name="AthleteClassLabel"
                                                        Text=""
                                                        FontSize="12"
                                                        TextColor="{DynamicResource TextSub}"/>
                                          </VerticalStackLayout>
                                   </Grid>
                            </Border>

                            <Label Text="PERFORMANCE OVERVIEW"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSub}"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">

                                   <Border Grid.Row="0"
                                           Grid.Column="0"
                                           BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="TOTAL PRs"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="{DynamicResource TextSub}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="TotalPRsLabel"
                                                        Text="8"
                                                        FontSize="27"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        FontAttributes="Bold"/>

                                                 <Label Text="Personal records"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="0"
                                           Grid.Column="1"
                                           BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="WORKOUTS"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="{DynamicResource TextSub}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="WorkoutsLabel"
                                                        Text="24"
                                                        FontSize="27"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        FontAttributes="Bold"/>

                                                 <Label Text="Completed"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="1"
                                           Grid.Column="0"
                                           BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="LATEST PR"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="{DynamicResource TextSub}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="LatestPRLabel"
                                                        Text="315 lbs"
                                                        FontSize="25"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="LatestPRExerciseLabel"
                                                        Text="Deadlift"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="1"
                                           Grid.Column="1"
                                           BackgroundColor="{DynamicResource CardBg}"
                                           Stroke="{DynamicResource CardBorderBrush}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="LAST WORKOUT"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="{DynamicResource TextSub}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="ImprovementLabel"
                                                        Text="N/A"
                                                        FontSize="27"
                                                        TextColor="{DynamicResource TextAccent}"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="ImprovementExerciseLabel"
                                                        Text="Completed"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource TextMuted}"/>
                                          </VerticalStackLayout>
                                   </Border>
                            </Grid>

                            <Label Text="CURRENT PERSONAL RECORDS"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSub}"/>

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="13">

                                          <Grid ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="10">
                                                 <Label Text="Bench Press"
                                                        FontSize="16"
                                                        TextColor="{DynamicResource TextMain}"/>

                                                 <Label x:Name="BenchPressLabel"
                                                        Grid.Column="1"
                                                        Text="185 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"/>
                                          </Grid>

                                          <BoxView HeightRequest="1" Color="{DynamicResource CardBorder}" HorizontalOptions="Fill"/>

                                          <Grid ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="10">
                                                 <Label Text="Back Squat"
                                                        FontSize="16"
                                                        TextColor="{DynamicResource TextMain}"/>

                                                 <Label x:Name="BackSquatLabel"
                                                        Grid.Column="1"
                                                        Text="275 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"/>
                                          </Grid>

                                          <BoxView HeightRequest="1" Color="{DynamicResource CardBorder}"/>

                                          <Grid ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="10">
                                                 <Label Text="Clean"
                                                        FontSize="16"
                                                        TextColor="{DynamicResource TextMain}"/>

                                                 <Label x:Name="CleanLabel"
                                                        Grid.Column="1"
                                                        Text="315 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextAccent}"/>
                                          </Grid>
                                   </VerticalStackLayout>
                            </Border>

                            <Label Text="STRENGTH PROGRESS"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSub}"/>

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="12">

                                          <Grid ColumnDefinitions="*,Auto">
                                                 <Label Text="1-Rep Max Progress"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextMain}"
                                                        VerticalOptions="Center"/>

                                                 <Picker x:Name="ExercisePicker"
                                                         Grid.Column="1"
                                                         Title="Exercise"
                                                         TextColor="{DynamicResource TextAccent}"
                                                         TitleColor="{DynamicResource TextSub}"
                                                         SelectedIndexChanged="ExercisePicker_SelectedIndexChanged">
                                                        <Picker.ItemsSource>
                                                               <x:Array Type="{x:Type x:String}">
                                                                      <x:String>Bench Press</x:String>
                                                                      <x:String>Back Squat</x:String>
                                                                      <x:String>Clean</x:String>
                                                               </x:Array>
                                                        </Picker.ItemsSource>
                                                 </Picker>
                                          </Grid>

                                          <lvc:CartesianChart
                                                 x:Name="StrengthChart"
                                                 HeightRequest="260"
                                                 BackgroundColor="{DynamicResource CardBg}"/>
                     
                                   </VerticalStackLayout>
                            </Border>
                     </VerticalStackLayout>
               </ScrollView>
                     <Grid Grid.Row="2"
                     ColumnDefinitions="*,*,*,*"
                     Padding="0,12,0,16"
                     BackgroundColor="{DynamicResource NavBg}">

                            <VerticalStackLayout Spacing="4">
                                   <Button Text="🏠"
                                          FontSize="23"
                                          TextColor="{DynamicResource PageBg}"
                                          Clicked="OnHomeClicked"
                                          HorizontalOptions="Center"/>
                                   <Label Text="Home"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                   <Button Text="👑"
                                          FontSize="22"
                                          TextColor="{DynamicResource PageBg}"
                                          Clicked="OnLeaderboardClicked"
                                          HorizontalOptions="Center"/>
                                   <Label Text="Leaderboard"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="4">
                                   <Button Text="📊"
                                          FontSize="22"
                                          TextColor="{DynamicResource PageBg}"
                                          Clicked="OnMetricsClicked"
                                          HorizontalOptions="Center"/>
                                   <Label Text="Metrics"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextAccent}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3"
                                                 Spacing="4">
                                   <Button Text="⚙️"
                                          FontSize="22"
                                          TextColor="{DynamicResource PageBg}"
                                          Clicked="OnSettingsClicked"
                                          HorizontalOptions="Center"/>
                                   <Label Text="Settings"
                                          FontSize="10"
                                          TextColor="{DynamicResource TextDim}"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                     </Grid>
              </Grid>
       </ContentPage>