<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="TuringTrainer.MetricsPage"
             BackgroundColor="#101010"
             Title="Metrics Page"
             Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*"
             Padding="20,12,20,0"
             RowSpacing="16">

              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12"
                    Padding="0,12,0,0">

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4"
                                          VerticalOptions="Center">

                            <Label Text="TURINGTRAINER"
                                   FontSize="12"
                                   CharacterSpacing="3"
                                   TextColor="#F5C542"
                                   FontAttributes="Bold"/>

                            <Label Text="My Metrics"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                     </VerticalStackLayout>
              </Grid>

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18"
                                          Padding="0,0,0,24">

                            <Label Text="STRENGTH PROGRESS"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#A5A5A5"/>

                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="12">

                                          <Grid ColumnDefinitions="*,Auto">
                                                 <Label Text="1-Rep Max Progress"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        VerticalOptions="Center"/>

                                                 <Picker x:Name="ExercisePicker"
                                                         Grid.Column="1"
                                                         Title="Exercise"
                                                         TextColor="#F5C542"
                                                         TitleColor="#A5A5A5"
                                                         SelectedIndexChanged="ExercisePicker_SelectedIndexChanged">
                                                        <Picker.ItemsSource>
                                                               <x:Array Type="{x:Type x:String}">
                                                               <x:String>Bench Press</x:String>
                                                               <x:String>Squat</x:String>
                                                               <x:String>Deadlift</x:String>
                                                               </x:Array>
                                                        </Picker.ItemsSource>
                                                 </Picker>
                                          </Grid>

                                          <lvc:CartesianChart
                                                 x:Name="StrengthChart"
                                                 HeightRequest="260"
                                                 BackgroundColor="#1C1C1C"/>
                     
                                   </VerticalStackLayout>
                            </Border>


                            <Label
                            Text="WORKOUT HISTORY"
                            FontSize="13"
                            CharacterSpacing="2"
                            FontAttributes="Bold"
                            TextColor="#A5A5A5"/>
                            
                            <Button
				x:Name="HistoryButton"
				Text="History&#160;&#160;v"
				FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            BackgroundColor="#1C1C1C"
                            TextColor="#F5C542"
                            BorderColor="#343434"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="16,10"
				Clicked="HistoryButton_Clicked"/>


			<VerticalStackLayout
				x:Name="HistoryLayout"
				IsVisible="False"
				Spacing="10">

				<Button
					Text="10/14"
					BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
					BorderWidth="1"
					CornerRadius="12"
					HeightRequest="55"
					HorizontalOptions="Fill"
					Clicked="PastWorkout_Clicked"/>

                            <VerticalStackLayout
                            x:Name="WorkoutOverview"
                            IsVisible="False"
                            BackgroundColor="#1C1C1C"
                            Padding="15"
                            Spacing="8">

                            <Label
                            Text="Workout Overview"
                            TextColor="White"
                            FontAttributes="Bold"/>

                            <Label
                            Text="Bench Press: 3 sets x 10 reps"
                            TextColor="#A5A5A5"/>

                            <Label
                            Text="Squat: 3 sets x 8 reps"
                            TextColor="#A5A5A5"/>

                            <Label
                            Text="Deadlift: 3 sets x 5 reps"
                            TextColor="#A5A5A5"/>

                     </VerticalStackLayout>

				<Button
					Text="9/20     "
					BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
					BorderWidth="1"
					CornerRadius="12"
					HeightRequest="55"
					HorizontalOptions="Fill"
					Clicked="PastWorkout_Clicked"/>

				<Button
					Text="9/16     "
					BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
					BorderWidth="1"
					CornerRadius="12"
					HeightRequest="55"
					HorizontalOptions="Fill"
					Clicked="PastWorkout_Clicked"/>

					
				<VerticalStackLayout
					x:Name="MoreHistoryLayout"
					IsVisible="False"
					Spacing="10">

					<Button
						Text="9/10  "
						BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
						BorderWidth="1"
						CornerRadius="12"
						HeightRequest="55"
						HorizontalOptions="Fill"
						Clicked="PastWorkout_Clicked"/>
						

					<Button
						Text="9/06  "
						BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
						BorderWidth="1"
						CornerRadius="12"
						HeightRequest="55"
						HorizontalOptions="Fill"
						Clicked="PastWorkout_Clicked"/>

					<Button
						Text="9/02  "
						BackgroundColor="#1C1C1C"
                                   TextColor="White"
                                   FontSize="15"
                                   BorderColor="#343434"
						BorderWidth="1"
						CornerRadius="12"
						HeightRequest="55"
						HorizontalOptions="Fill"
						Clicked="PastWorkout_Clicked"/>

				</VerticalStackLayout>

				<Button
					x:Name="SeeAllButton"
					Text="See All"
					FontSize="14"
                                   FontAttributes="Bold"
                                   BackgroundColor="Transparent"
                                   TextColor="#F5C542"
					Clicked="SeeAllButton_Clicked"/>


			</VerticalStackLayout>

                     </VerticalStackLayout>
              </ScrollView>
       </Grid>
</ContentPage>
