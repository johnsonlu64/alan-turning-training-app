<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="TuringTrainer.MetricsPage"
             BackgroundColor="#101010"
             Title="Metrics Page"
             Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto,*"
             Padding="20,12,20,0"
             RowSpacing="16">

              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12"
                    Padding="0,12,0,0">

                     <Button Text="‹"
                             FontSize="32"
                             WidthRequest="44"
                             HeightRequest="44"
                             Padding="0"
                             BackgroundColor="Transparent"
                             TextColor="#F5C542"
                             Clicked="OnBackClicked"
                             VerticalOptions="Center"/>

                     <VerticalStackLayout Grid.Column="1"
                                          Spacing="4"
                                          VerticalOptions="Center">

                            <Label Text="TURINGTRAINER"
                                   FontSize="12"
                                   CharacterSpacing="3"
                                   TextColor="#F5C542"
                                   FontAttributes="Bold"/>

                            <Label Text="Athlete Metrics"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                     </VerticalStackLayout>
              </Grid>

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Spacing="18"
                                          Padding="0,0,0,24">

                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <Grid ColumnDefinitions="Auto,*"
                                         ColumnSpacing="14">

                                          <Border WidthRequest="54"
                                                  HeightRequest="54"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 27"
                                                  VerticalOptions="Center">

                                                 <Image Source="blank_profile_picture.png"
                                                        WidthRequest="54"
                                                        HeightRequest="54"
                                                        Aspect="AspectFill"/>
                                          </Border>

                                          <VerticalStackLayout Grid.Column="1"
                                                               Spacing="5"
                                                               VerticalOptions="Center">

                                                 <Label x:Name="AthleteNameLabel"
                                                        Text="John Doe"
                                                        FontSize="20"
                                                        FontAttributes="Bold"
                                                        TextColor="White"/>

                                                 <Label x:Name="AthleteClassLabel"
                                                        Text="Class 1 • Varsity Football"
                                                        FontSize="12"
                                                        TextColor="#A5A5A5"/>
                                          </VerticalStackLayout>
                                   </Grid>
                            </Border>

                            <Label Text="PERFORMANCE OVERVIEW"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#A5A5A5"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">

                                   <Border Grid.Row="0"
                                           Grid.Column="0"
                                           BackgroundColor="#1C1C1C"
                                           Stroke="#343434"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="TOTAL PRs"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="#A5A5A5"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="TotalPRsLabel"
                                                        Text="8"
                                                        FontSize="27"
                                                        TextColor="#F5C542"
                                                        FontAttributes="Bold"/>

                                                 <Label Text="Personal records"
                                                        FontSize="11"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="0"
                                           Grid.Column="1"
                                           BackgroundColor="#1C1C1C"
                                           Stroke="#343434"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="WORKOUTS"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="#A5A5A5"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="WorkoutsLabel"
                                                        Text="24"
                                                        FontSize="27"
                                                        TextColor="#F5C542"
                                                        FontAttributes="Bold"/>

                                                 <Label Text="Completed"
                                                        FontSize="11"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="1"
                                           Grid.Column="0"
                                           BackgroundColor="#1C1C1C"
                                           Stroke="#343434"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="LATEST PR"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="#A5A5A5"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="LatestPRLabel"
                                                        Text="315 lbs"
                                                        FontSize="25"
                                                        TextColor="#F5C542"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="LatestPRExerciseLabel"
                                                        Text="Deadlift"
                                                        FontSize="11"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Grid.Row="1"
                                           Grid.Column="1"
                                           BackgroundColor="#1C1C1C"
                                           Stroke="#343434"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           Padding="15">

                                          <VerticalStackLayout Spacing="7">

                                                 <Label Text="IMPROVEMENT"
                                                        FontSize="11"
                                                        CharacterSpacing="1"
                                                        TextColor="#A5A5A5"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="ImprovementLabel"
                                                        Text="+12%"
                                                        FontSize="27"
                                                        TextColor="#F5C542"
                                                        FontAttributes="Bold"/>

                                                 <Label x:Name="ImprovementExerciseLabel"
                                                        Text="Bench Press"
                                                        FontSize="11"
                                                        TextColor="#999999"/>
                                          </VerticalStackLayout>
                                   </Border>
                            </Grid>

                            <Label Text="CURRENT PERSONAL RECORDS"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#A5A5A5"/>

                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="13">

                                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                 <Label Text="Bench Press"
                                                        FontSize="16"
                                                        TextColor="White"/>

                                                 <Label x:Name="BenchPressLabel"
                                                        Grid.Column="1"
                                                        Text="185 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="#F5C542"/>
                                          </Grid>

                                          <BoxView HeightRequest="1" Color="#343434" HorizontalOptions="Fill"/>

                                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                 <Label Text="Squat"
                                                        FontSize="16"
                                                        TextColor="White"/>

                                                 <Label x:Name="SquatLabel"
                                                        Grid.Column="1"
                                                        Text="275 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="#F5C542"/>
                                          </Grid>

                                          <BoxView HeightRequest="1" Color="#343434"/>

                                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                 <Label Text="Deadlift"
                                                        FontSize="16"
                                                        TextColor="White"/>

                                                 <Label x:Name="DeadliftLabel"
                                                        Grid.Column="1"
                                                        Text="315 lbs"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="#F5C542"/>
                                          </Grid>
                                   </VerticalStackLayout>
                            </Border>

                            <Label Text="STRENGTH PROGRESS"
                                   FontSize="13"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#A5A5A5"/>

                            <Border BackgroundColor="#1C1C1C"
                                    Stroke="#343434"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18">

                                   <VerticalStackLayout Spacing="12">

                                          <Grid ColumnDefinitions="*,Auto">
                                                 <Label Text="1-Rep Max Progress"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        VerticalOptions="Center"/>

                                                 <Picker x:Name="ExercisePicker"
                                                         Grid.Column="1"
                                                         Title="Exercise"
                                                         TextColor="#F5C542"
                                                         TitleColor="#A5A5A5"
                                                         SelectedIndexChanged="ExercisePicker_SelectedIndexChanged">
                                                        <Picker.ItemsSource>
                                                               <x:Array Type="{x:Type x:String}">
                                                               <x:String>Bench Press</x:String>
                                                               <x:String>Squat</x:String>
                                                               <x:String>Deadlift</x:String>
                                                               </x:Array>
                                                        </Picker.ItemsSource>
                                                 </Picker>
                                          </Grid>

                                          <lvc:CartesianChart
                                                 x:Name="StrengthChart"
                                                 HeightRequest="260"
                                                 BackgroundColor="#1C1C1C"/>
                     
                                   </VerticalStackLayout>
                            </Border>
                     </VerticalStackLayout>
              </ScrollView>
       </Grid>
</ContentPage>
