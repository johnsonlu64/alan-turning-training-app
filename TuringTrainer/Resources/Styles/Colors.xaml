<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#DEB200</Color>
    <!-- Text that sits on top of Primary (buttons, highlights) -->
    <Color x:Key="TextOnPrimary">#100A00</Color>

    <!-- Backgrounds -->
    <!-- Main screen background -->
    <Color x:Key="AppBackground">#060605</Color>
    <!-- Cards, inputs, popups -->
    <Color x:Key="CardBackground">#191817</Color>
    <!-- Slightly lighter card for layered sections -->
    <Color x:Key="CardBackgroundLight">#242322</Color>
    <!-- Secondary buttons / chips-->
    <Color x:Key="SecondaryButtonBackground">#282727</Color>

    <!-- Text -->
    <!-- Main text everywhere -->
    <Color x:Key="MainText">#FCFCFB</Color>
    <!-- Hint, placeholder, muted text -->
    <Color x:Key="FaintText">#A0A09E</Color>
    <!-- Text on secondary buttons or Success / Warning / Error -->
    <Color x:Key="TextOnSecondaryButton">#FCFCFC</Color>

    <!-- Lines -->
    <!-- Borders around inputs and cards -->
    <Color x:Key="Border">#292928</Color>
    <!-- Separator lines between sections -->
    <Color x:Key="Divider">#222221</Color>

    <!-- Status -->
    <Color x:Key="Success">#7BC019</Color>
    <Color x:Key="Warning">#FFAB64</Color>
    <Color x:Key="Error">#D7386E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundLightBrush" Color="{StaticResource CardBackgroundLight}"/>
    <SolidColorBrush x:Key="MainTextBrush" Color="{StaticResource MainText}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{StaticResource FaintText}"/>
</ResourceDictionary>