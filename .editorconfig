root = true


# C# files
[*.cs]

# File names should use PascalCase.
# Directory names should use PascalCase.
# Keep each source file named after its main class where possible.
# Prefer one core class per file.
dotnet_naming_rule.nonpublic_members_use_underscore_camel_case.severity = suggestion
dotnet_naming_rule.nonpublic_members_use_underscore_camel_case.symbols = nonpublic_fields_and_properties
dotnet_naming_rule.nonpublic_members_use_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.nonpublic_fields_and_properties.applicable_kinds = field, property
dotnet_naming_symbols.nonpublic_fields_and_properties.applicable_accessibilities = private, protected, internal, protected_internal

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case


# Use 4 spaces for indentation when writing code.
# Use PascalCase for naming classes, methods, enumerations, public fields, and public properties. 
# Namespace ‘using’ declarations go at the top of the file before any namespaces. Organize the ‘using’ imports by alphabetical order and have System imports always organized first.
# Use camelCase for names of local variables and parameters.

indent_style = space
indent_space = 4
tab_width = 4

dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_style.camel_case_style.capitalization = camel_case
